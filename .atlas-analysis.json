  "keyFeatures": [
    "AI Agents — configurable multi-channel agents (website, email, SMS, voice) with knowledge base and tool-calling support",
    "OpenAI-compatible Chat Completions — drop-in replacement for OpenAI's API with streaming support",
    "Smart Lists — contact list management for lead capture and segmentation",
    "Sequences — automated email/SMS outreach campaigns",
    "Knowledge Base Documents — upload and manage documents powering agent responses",
    "Media Generation — text-to-speech audio via ElevenLabs, images, and video",
    "Browser Automation — AI-driven browser tasks with residential proxy and authenticated sessions",
    "MCP Server — Model Context Protocol integration for Claude Desktop, Cursor, and Windsurf",
    "Two authentication modes — Company API Keys and Personal Access Keys (pak_)",
    "Pagination — consistent page/pageSize pattern across all list endpoints"
  ],
  "publicApiSurface": [
